// Moments — modelo de dados (Fase 1)
// Campos de sincronização comuns aos registros do usuário:
//   ownerId   — proprietário (o compartilhamento nunca transfere a propriedade)
//   rev       — versão monotônica global (sequência moments_rev) para o sync incremental
//   deletedAt — exclusão lógica (tombstone) propagada na sincronização
// Observação: as relações de proprietário são mantidas por ownerId (string) para manter
// o schema enxuto; chaves estrangeiras podem ser acrescentadas por entidade quando útil.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  active
  blocked
}

// ----------------------- Contas e acesso -----------------------

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  birthdate    String? // YYYY-MM-DD, opcional (verificação de idade)
  photoUrl     String?
  status       AccountStatus @default(active)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions Session[]
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  refreshHash String // hash do refresh token (nunca o token em claro)
  deviceName  String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Compartilhamento polimórfico: concede acesso a UM item específico (entityType + entityId).
model Share {
  id          String   @id @default(uuid())
  ownerId     String // dono do item (quem compartilhou)
  recipientId String // destinatário (conta Moments)
  entityType  String // coleção do item (ex.: "appointments")
  entityId    String
  permission  String // "ver" | "editar"
  status      String   @default("active") // "active" | "revoked"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, recipientId, entityType, entityId])
  @@index([recipientId, status])
  @@index([entityType, entityId])
}

// Auditoria de alterações (quem, o quê, antes, depois, quando).
model ChangeLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  ownerId    String // dono do item alterado (recebe o aviso)
  actorId    String // quem alterou
  field      String?
  before     String?
  after      String?
  createdAt  DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([entityType, entityId])
}

// ----------------------- Preferências -----------------------

model Preference {
  id        String    @id @default(uuid())
  ownerId   String    @unique
  priorities String[] @default([])
  morning   String? // HH:MM
  night     String?
  sunday    String?
  timezone  String    @default("America/Sao_Paulo")
  notifOn   Boolean   @default(true)
  rev       Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, rev])
}

// ----------------------- Conteúdo do usuário (sincronizável) -----------------------

model Appointment {
  id             String    @id @default(uuid())
  ownerId        String
  title          String
  date           String // YYYY-MM-DD
  time           String // HH:MM
  endTime        String?
  place          String?
  notes          String?
  participantIds String[]  @default([])
  status         String    @default("scheduled")
  rev            Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([ownerId, rev])
}

model Task {
  id        String    @id @default(uuid())
  ownerId   String
  text      String
  date      String?
  time      String?
  priority  String? // "alta" | "media" | ""
  done      Boolean   @default(false)
  doneAt    String?
  goalId    String?
  rev       Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, rev])
}

model Goal {
  id          String    @id @default(uuid())
  ownerId     String
  name        String
  description String?
  type        String    @default("count") // "money" | "count"
  targetValue Float?
  currentValue Float    @default(0)
  unit        String?
  startDate   String
  deadline    String
  status      String    @default("active")
  rev         Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([ownerId, rev])
}

model GoalStep {
  id        String    @id @default(uuid())
  ownerId   String
  goalId    String
  text      String
  done      Boolean   @default(false)
  deadline  String?
  doneAt    String?
  rev       Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, rev])
  @@index([goalId])
}

model GoalHistory {
  id        String    @id @default(uuid())
  ownerId   String
  goalId    String
  date      String
  value     Float?
  note      String?
  source    String    @default("manual")
  rev       Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, rev])
  @@index([goalId])
}

model Habit {
  id             String    @id @default(uuid())
  ownerId        String
  name           String
  frequency      String    @default("Diário")
  objective      String?
  durationTarget Int?
  startDate      String
  status         String    @default("active")
  rev            Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([ownerId, rev])
}

model HabitLog {
  id        String    @id @default(uuid())
  ownerId   String
  habitId   String
  date      String
  done      Boolean   @default(true)
  duration  Int?
  note      String?
  mood      String?
  rev       Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, rev])
  @@index([habitId])
}

model FinanceNote {
  id            String    @id @default(uuid())
  ownerId       String
  date          String
  amount        Float
  type          String // "receita" | "despesa" | "economia"
  category      String?
  description   String?
  goalId        String?
  receiptFileId String?
  rev           Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([ownerId, rev])
}

model FileItem {
  id          String    @id @default(uuid())
  ownerId     String
  name        String
  fileType    String // "documento" | "foto" | "comprovante" | "audio"
  docDate     String?
  description String?
  category    String?
  storageKey  String? // chave no armazenamento de objetos (upload real em fase posterior)
  privacy     String    @default("private")
  rev         Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([ownerId, rev])
}

model DiaryEntry {
  id         String    @id @default(uuid())
  ownerId    String
  date       String
  time       String
  title      String
  text       String?
  summary    String?
  mood       String?
  audioKey   String?
  photoKeys  String[]  @default([])
  personIds  String[]  @default([])
  rev        Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([ownerId, rev])
}

model Dream {
  id          String    @id @default(uuid())
  ownerId     String
  type        String // "sono" | "vida"
  title       String
  description String?
  date        String
  goalId      String?
  rev         Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([ownerId, rev])
}

model Idea {
  id          String    @id @default(uuid())
  ownerId     String
  title       String
  description String?
  date        String
  category    String?
  goalId      String?
  rev         Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([ownerId, rev])
}

model ImportantPerson {
  id        String    @id @default(uuid())
  ownerId   String
  name      String
  nickname  String?
  relation  String?
  birthday  String? // MM-DD
  phone     String?
  howMet    String?
  notes     String?
  rev       Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, rev])
}

model Dependent {
  id          String    @id @default(uuid())
  ownerId     String
  name        String
  birthdate   String?
  guardianIds String[]  @default([])
  notes       String?
  rev         Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([ownerId, rev])
}

model Notification {
  id          String    @id @default(uuid())
  ownerId     String
  type        String
  entityType  String?
  entityId    String?
  message     String
  scheduledAt DateTime
  status      String    @default("scheduled")
  sentAt      DateTime?
  readAt      DateTime?
  rev         Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([ownerId, rev])
}

model AiMessage {
  id         String    @id @default(uuid())
  ownerId    String
  role       String // "user" | "assistant"
  text       String
  audioKey   String?
  confirmed  Boolean?
  rev        Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([ownerId, rev])
}

model Retrospective {
  id          String    @id @default(uuid())
  ownerId     String
  periodStart String
  periodEnd   String
  type        String // "semana" | "mes" | "ano"
  summary     String?
  data        Json?
  rev         Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([ownerId, rev])
}
