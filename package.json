    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.5",
    "fastify": "4.28.1",
    "jsonwebtoken": "9.0.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "22.9.0",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
