{
  "name": "moments-api",
  "version": "0.1.0",
  "private": true,
  "description": "Moments — Fase 1: contas, modelo de dados, API e sincronização",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
