# Banco de dados (local via docker-compose: porta 5433)
DATABASE_URL="postgresql://moments:moments@localhost:5433/moments?schema=public"

# Segredos de autenticação — troque em produção por valores longos e aleatórios.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Duração dos tokens
ACCESS_TTL_MIN=15          # minutos (token de acesso)
REFRESH_TTL_DAYS=60        # dias (token de atualização / sessão)

PORT=3000

# Produção: origens permitidas no CORS (a URL do app web), separadas por vírgula.
# Vazio libera todas (apenas para desenvolvimento).
CORS_ORIGIN=

# IA (opcional). Sem nenhuma chave, o assistente usa o motor determinístico (grátis).
# Com uma chave, as conversas e a análise do diário usam o provedor, sempre
# fundamentado nos dados do usuário e sem nunca criar/alterar nada sozinho.
# A ordem de preferência é: Gemini -> Claude -> motor local.

# Opção GRÁTIS recomendada — Groq (console.groq.com/keys): sem cartão, rápido e estável.
# O app descobre sozinho um modelo válido da sua conta (não precisa definir o modelo).
# GROQ_API_KEY=gsk_...
# Modelo (opcional). Se não definir, é escolhido automaticamente (ex.: llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.3-70b-versatile

# Opção GRÁTIS alternativa — Gemini (Google AI Studio): crie a chave em aistudio.google.com/apikey
# (sem cartão; modelos Flash têm camada gratuita, mas podem ficar sobrecarregados).
# GEMINI_API_KEY=...
# Modelo (opcional). O app tenta vários automaticamente se este não for definido.
# GEMINI_MODEL=gemini-3.8-flash

# Opção paga — Claude (Anthropic), caso prefira.
# ANTHROPIC_API_KEY=sk-ant-...
# Modelo (opcional). Padrão: claude-opus-5-5. Para custo baixo: claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-haiku-5-5
# Esforço de raciocínio (opcional): low | medium | high. Padrão: low (rápido/barato).
# ANTHROPIC_EFFORT=low

