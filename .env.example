# Banco de dados (local via docker-compose: porta 5433)
DATABASE_URL="postgresql://moments:moments@localhost:5433/moments?schema=public"

# Segredos de autenticação — troque em produção por valores longos e aleatórios.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Duração dos tokens
ACCESS_TTL_MIN=15          # minutos (token de acesso)
REFRESH_TTL_DAYS=60        # dias (token de atualização / sessão)

PORT=3000

# Produção: origens permitidas no CORS (a URL do app web), separadas por vírgula.
# Vazio libera todas (apenas para desenvolvimento).
CORS_ORIGIN=

# IA (opcional). Sem a chave do Groq, o assistente usa o motor determinístico (grátis).
# Com a chave, as conversas e a análise do diário usam o Groq, sempre fundamentado nos
# dados do usuário e sem nunca criar/alterar nada sozinho. Em qualquer falha, cai no
# motor local automaticamente.

# Criptografia do diário (opcional, recomendado em produção): chave de 32 bytes.
# Se definida aqui (fora do banco), nem quem tem acesso só ao banco lê o diário.
# Sem ela, o servidor gera e guarda uma chave própria (proteção menor).
# Gere com:  openssl rand -hex 32
# ENCRYPTION_KEY=

# Groq (grátis, sem cartão): crie a chave em console.groq.com/keys.
# O app descobre sozinho um modelo válido da sua conta (não precisa definir o modelo).
# GROQ_API_KEY=gsk_...
# Modelo (opcional). Se não definir, é escolhido automaticamente (ex.: llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.3-70b-versatile
# Modelo de transcrição de voz (opcional). Descoberto automaticamente se não definido.
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

